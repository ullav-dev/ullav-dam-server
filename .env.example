# Server
HOST=0.0.0.0
PORT=8080

# PostgreSQL
DATABASE_URL=postgres://dam:dam@localhost:5432/dam

# PDFium library path for PDF thumbnail generation
PDFIUM_LIB_PATH=/path/to/libpdfium.dylib

# LibreOffice binary for Office document thumbnail generation (docx, xlsx, pptx, etc.)
# macOS: /Applications/LibreOffice.app/Contents/MacOS/soffice
# Linux: /usr/lib/libreoffice/program/soffice  (or 'soffice' if on $PATH)
SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=dam-assets
S3_REGION=us-east-1
