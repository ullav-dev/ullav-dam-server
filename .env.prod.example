# Copy to .env.prod and fill in values before running docker compose

HOST=0.0.0.0
PORT=8080

# PostgreSQL — must match db service credentials in docker-compose-prod.yaml
DATABASE_URL=postgres://dam:<password>@db:5432/dam
DATABASE_USER=dam
DATABASE_PASSWORD=<password>
DATABASE_NAME=dam

# MinIO / S3
S3_ENDPOINT=http://<minio-host>:9000
S3_ACCESS_KEY_ID=<access-key>
S3_SECRET_ACCESS_KEY=<secret-key>
S3_BUCKET=dam-assets
S3_REGION=us-east-1

# Thumbnail settings
THUMBNAIL_SIZE=256
